{
  "scriptDelta" : 5,
  // Base breast capacity. (Default unless set in size config)
  "breastCapacity": 10,
  // Max natural generation capacity. (Causes leaking going above 1)
  "milkGenerationMaximum": 1.1,
  // Average lactation time, amount, and minimum amount of time to pass.
  "lactationTime": 5,
  "lactationTimeMinimum": 1,
  "lactationAmount": 0.5,
  // How much time to leak after lactating, and multiplier for velocity.
  "lactationLeakTime": 1,
  "lactationLeakVelocity": 0.5,
  "lactationLeakInterval": [0.05, 0.25],
  // Velocity and random spread for lactation droplets.
  "lactationVelocity": [2.5, 1.5],
  "lactationVelocityVariance": [1.5, 1],
  "lactationSpread": 45,
  // Projectile type.
  "lactationProjectile": "starpoundsmilkspawner",
  // Particle size and velocity scaling based on lactation amount.
  "lactationParticleScaleMaximum": 2, // Scaling reaches this size faster that if it were [0.25, 2].
  "lactationParticleScale": [0.25, 3],
  "lactationVelocityScale": [0.5, 2],
  // Droplet particles.
  "lactationParticleConfig": {
    "position": [0, 0],
    "size": 2,
    "timeToLive": 3,
    "destructionAction": "shrink",
    "destructionTime": 1,
    "collidesForeground": true,
    "collidesLiquid": true,
    "variance": {
      "size": 1
    }
  },
  // Spray particles.
  "lactationSprayParticleCount": 4,
  "lactationSprayParticleConfig": {
    "position": [0, 0],
    "size": 1.25,
    "timeToLive": 0.15,
    "destructionAction": "shrink",
    "destructionTime": 0.1,
    "collidesForeground": true,
    "collidesLiquid": true,
    "variance": {
      "initialVelocity": [1.25, 1.25],
      "size": 0.25,
      "timeToLive": 0.05
    }
  }
}
