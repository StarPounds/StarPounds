{
  "animatedParts" : {
    "parts" : {
      "food" : {
        "properties" : {
          "image" : "<partImage>:<stage>",
          "centered" : false,
          "imagePosition" : [-16, 0]
        }
      }
    }
  },

  "particleEmitters" : {
    "bite" : {
      "enabled" : false,
      "emissionRate" : 1.0,
      "offsetRegion" : [0, 0, 5, 5],
      "particles" : [
        { // muscle, large
          "count" : 4,
          "particle" : {
            "type" : "ember",
            "size" : 2.0,
            "color" : [121, 21, 0, 255],
            "initialVelocity" : [0, 2],
            "finalVelocity" : [0, -50],
            "approach" : [0, 50],
            "timeToLive" : 0.75,
            "variance" : {
              "initialVelocity" : [10, 3]
            }
          }
        },
        { // muscle, small
          "count" : 4,
          "particle" : {
            "type" : "ember",
            "size" : 1.0,
            "color" : [121, 21, 0, 255],
            "initialVelocity" : [0, 5],
            "finalVelocity" : [0, -50],
            "approach" : [0, 50],
            "timeToLive" : 0.75,
            "variance" : {
              "initialVelocity" : [10, 10]
            }
          }
        }
      ]
    }
  },

  "sounds" : {
    "bite" : ["/sfx/humanoid/eat1.ogg", "/sfx/humanoid/eat2.ogg"]
  }
}
